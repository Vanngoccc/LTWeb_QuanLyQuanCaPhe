@model QuanLyQuanCaPhe.Models.SanPham

@{
    ViewBag.Title = "Chi tiết Sản phẩm: " + Model.TenSP;
}

<div class="row pt-4">
    <div class="col-md-12">
        <h2>@ViewBag.Title</h2>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-md-6 text-center">
        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img src="@Url.Content(Model.HinhAnh)" alt="@Model.TenSP" class="img-thumbnail" style="max-width: 100%; height: auto;" />
        }
        else
        {
            <img src="@Url.Content("~/Content/Images/placeholder.jpg")" alt="Chưa có ảnh" class="img-thumbnail" style="max-width: 100%; height: auto;" />
        }
    </div>

    <div class="col-md-6">
        <h3 class="mt-4 mt-md-0">@Model.TenSP</h3>
        <p class="text-muted">@Model.LoaiSP.TenLoai</p>

        <h2 class="text-danger">
            @String.Format("{0:N0}", Model.GiaBan) VNĐ
        </h2>

        <p><strong>Mô tả chi tiết:</strong></p>
        <p>@Html.Raw(Model.MoTaChiTiet)</p>

        <div class="mt-4">
            @Html.ActionLink("Sửa sản phẩm", "Edit", new { id = Model.MaSP }, new { @class = "btn btn-warning" })
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
</div>