@model QuanLyQuanCaPhe.Models.SanPham

@{
    ViewBag.Title = "Thêm Sản Phẩm Mới";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("Create", "SanPhams", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row">
            <div class="col-md-6">

                <div class="form-group mb-3">
                    @Html.LabelFor(model => model.TenSP, "Tên Sản Phẩm", new { @class = "control-label" })
                    @Html.EditorFor(model => model.TenSP, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Cà phê sữa đá" } })
                    @Html.ValidationMessageFor(model => model.TenSP, "", new { @class = "text-danger" })
                </div>

                <div class="form-group mb-3">
                    @Html.LabelFor(model => model.GiaBan, "Giá Bán (VNĐ)", new { @class = "control-label" })
                    @Html.EditorFor(model => model.GiaBan, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: 25000" } })
                    @Html.ValidationMessageFor(model => model.GiaBan, "", new { @class = "text-danger" })
                </div>

                <div class="form-group mb-3">
                    @Html.LabelFor(model => model.MaLoai, "Loại Sản Phẩm", new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.MaLoai, (SelectList)ViewBag.MaLoai, "-- Chọn loại SP --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.MaLoai, "", new { @class = "text-danger" })
                </div>

                <div class="form-group mb-3">
                    @Html.LabelFor(model => model.MoTaChiTiet, "Mô tả chi tiết", new { @class = "control-label" })
                    @Html.TextAreaFor(model => model.MoTaChiTiet, new { @class = "form-control", rows = 4, placeholder = "Nhập mô tả sản phẩm..." })
                    @Html.ValidationMessageFor(model => model.MoTaChiTiet, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group mb-3">
                    @Html.LabelFor(model => model.HinhAnh, "Hình Ảnh Sản Phẩm", new { @class = "control-label" })
                    <div class="border p-3 bg-light rounded">
                        <input type="file" name="uploadHinh" class="form-control-file" />
                        <small class="form-text text-muted">Chỉ chấp nhận file ảnh (jpg, png).</small>
                    </div>
                    @Html.ValidationMessageFor(model => model.HinhAnh, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group mt-4">
            <div class="col-md-12">
                <input type="submit" value="Tạo Sản Phẩm" class="btn btn-success btn-lg" />
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}