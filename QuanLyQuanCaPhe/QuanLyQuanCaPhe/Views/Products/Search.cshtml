@model IEnumerable<QuanLyQuanCaPhe.Models.SanPham>

<h2>Kết quả tìm kiếm cho: "@ViewBag.SearchQuery"</h2>
<hr />

<p>Tìm thấy @Model.Count() sản phẩm phù hợp.</p>

<div class="row mt-4">
    @if (@Model.Count() > 0)
    {
        foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <img src="@Url.Content(item.HinhAnh ?? "/Content/hinhanh/placeholder.jpg")"
                         class="card-img-top"
                         alt="@item.TenSP"
                         style="height: 200px; object-fit: cover;">

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate">@item.TenSP</h5>

                        <p class="card-text fw-bold text-danger mt-auto">
                            @String.Format("{0:N0}", item.GiaBan) VNĐ
                        </p>

                        <a href="@Url.Action("Details", "Products", new { id = item.MaSP })"
                           class="btn btn-sm btn-success mt-2">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p>Xin lỗi, không tìm thấy sản phẩm nào phù hợp với từ khóa "@ViewBag.SearchQuery".</p>
        </div>
    }
</div>