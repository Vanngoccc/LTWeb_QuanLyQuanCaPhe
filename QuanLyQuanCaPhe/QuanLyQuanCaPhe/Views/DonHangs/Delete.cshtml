@model QuanLyQuanCaPhe.Models.DonHang

@{
    ViewBag.Title = "Xóa Đơn hàng";
}

<h2 class="text-danger">Xóa Đơn hàng</h2>
<hr />
<h3 class="alert alert-danger">Bạn có chắc chắn muốn xóa vĩnh viễn đơn hàng này không?</h3>

<div>
    <h4 class="mb-3">Mã đơn hàng: @Model.MaDH</h4>
    <dl class="dl-horizontal">

        <dt>Khách hàng:</dt>
        <dd>@Html.DisplayFor(model => model.User.HoTen)</dd>

        <dt>Tổng tiền:</dt>
        <dd class="text-danger">@String.Format("{0:N0} VNĐ", Model.TongTien)</dd>

        <dt>Ngày đặt:</dt>
        <dd>@Html.DisplayFor(model => model.NgayDat)</dd>

        <dt>Địa chỉ giao:</dt>
        <dd>@Html.DisplayFor(model => model.DiaChiGiao)</dd>

    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color mt-4">
            <input type="submit" value="Xác nhận Xóa" class="btn btn-danger" />
            @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>