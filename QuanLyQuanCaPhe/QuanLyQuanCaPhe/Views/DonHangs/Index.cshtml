@model IEnumerable<QuanLyQuanCaPhe.Models.DonHang>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    // Hàm này sẽ chuyển số trạng thái thành chữ
    string GetStatusText(int status)
    {
        switch (status)
        {
            case 0: return "Mới đặt";
            case 1: return "Đang giao";
            case 2: return "Hoàn thành";
            case 3: return "Đã hủy";
            default: return "Không xác định";
        }
    }
}
<h2>Danh sách Đơn hàng</h2>
<hr />

<p>
    @Html.ActionLink("← Quay về Dashboard", "Index", "Admin", null, new { @class = "btn btn-sm btn-secondary me-2" })
</p>

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr class="table-info">
            <th>@Html.DisplayName("Tên Khách Hàng")</th>
            <th>@Html.DisplayName("Ngày Đặt")</th>
            <th>@Html.DisplayName("Tổng Tiền")</th>
            <th>@Html.DisplayName("Trạng Thái")</th>
            <th>@Html.DisplayName("Địa Chỉ Giao")</th>
            <th style="width: 15%;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.User.HoTen)</td>

                <td>@Html.DisplayFor(modelItem => item.NgayDat)</td>

                <td>@String.Format("{0:N0}", item.TongTien) VNĐ</td>

                <td>
                    <span class="badge @(item.TrangThai == 2 ? "bg-success" : item.TrangThai == 3 ? "bg-danger" : "bg-warning")">
                        @GetStatusText(item.TrangThai)
                    </span>
                </td>

                <td>@Html.DisplayFor(modelItem => item.DiaChiGiao)</td>

                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.MaDH }, new { @class = "btn btn-sm btn-outline-info" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.MaDH }, new { @class = "btn btn-sm btn-outline-secondary" })
                </td>
            </tr>
        }
    </tbody>
</table>
