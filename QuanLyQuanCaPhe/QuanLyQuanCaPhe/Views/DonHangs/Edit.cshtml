@model QuanLyQuanCaPhe.Models.DonHang

@{
    ViewBag.Title = "Cập nhật Đơn hàng #" + Model.MaDH;
}

<h2>@ViewBag.Title</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Thay đổi trạng thái đơn hàng.</h4>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(model => model.MaDH)
        @Html.HiddenFor(model => model.MaKH)

        <div class="form-group">
            @Html.LabelFor(model => model.MaDH, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-9">
                <p class="form-control-static">@Html.DisplayFor(model => model.MaDH)</p>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.User.HoTen, "Khách hàng", htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-9">
                <p class="form-control-static">@Html.DisplayFor(model => model.User.HoTen)</p>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.TongTien, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-9">
                <p class="form-control-static text-danger font-weight-bold">@String.Format("{0:N0} VNĐ", Model.TongTien)</p>
            </div>
        </div>

        <div class="form-group bg-light p-3">
            @Html.LabelFor(model => model.TrangThai, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-9">
                @Html.DropDownList("TrangThai", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.TrangThai, "", new { @class = "text-danger" })
            </div>
        </div>

        @Html.HiddenFor(model => model.NgayDat)
        @Html.HiddenFor(model => model.TongTien)
        @Html.HiddenFor(model => model.DiaChiGiao)

        <div class="form-group mt-4">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Lưu thay đổi" class="btn btn-success" />
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
}