@model QuanLyQuanCaPhe.Models.LoaiSP

@{
    ViewBag.Title = "Chi tiết Danh Mục";
}

<div class="row">
    <div class="col-md-8 mx-auto">

        <h2>@ViewBag.Title</h2>
        <h4 class="text-primary">@Model.TenLoai</h4>
        <hr />

        <dl class="dl-horizontal">

            <dt class="fw-bold">@Html.DisplayNameFor(model => model.MaLoai)</dt>
            <dd>@Html.DisplayFor(model => model.MaLoai)</dd>
            <hr />

            <dt class="fw-bold">@Html.DisplayNameFor(model => model.TenLoai)</dt>
            <dd>@Html.DisplayFor(model => model.TenLoai)</dd>
            <hr />

            <dt class="fw-bold">@Html.DisplayNameFor(model => model.MoTa)</dt>
            <dd>@Html.DisplayFor(model => model.MoTa)</dd>
            <hr />
        </dl>

        <p class="mt-4">
            @Html.ActionLink("Sửa", "Edit", new { id = Model.MaLoai }, new { @class = "btn btn-info" })
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
        </p>
    </div>
</div>