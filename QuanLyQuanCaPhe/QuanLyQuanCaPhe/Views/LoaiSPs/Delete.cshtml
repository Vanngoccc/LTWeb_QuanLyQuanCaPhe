@model QuanLyQuanCaPhe.Models.LoaiSP

@{
    ViewBag.Title = "Xác nhận XÓA Danh Mục";
}

<h2 class="text-danger">Xác nhận XÓA Danh Mục</h2>
<hr />

<h3 class="mb-4">Bạn có chắc chắn muốn xóa danh mục này?</h3>

<dl class="dl-horizontal">
    <dt>Tên Danh Mục:</dt>
    <dd>
        <strong>@Html.DisplayFor(model => model.TenLoai)</strong>
    </dd>

    <dt>Mô Tả:</dt>
    <dd>
        @Html.DisplayFor(model => model.MoTa)
    </dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-actions no-color mt-4">
        <input type="submit" value="XÓA VĨNH VIỄN" class="btn btn-lg btn-danger" />
        @Html.ActionLink("Hủy bỏ và Quay lại", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
    </div>
}